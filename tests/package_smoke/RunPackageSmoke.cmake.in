cmake_minimum_required(VERSION 3.28)

set(_test_config "${TEST_CONFIG}")

set(_install_prefix "@MODERN_IO_PACKAGE_SMOKE_INSTALL_PREFIX@")
set(_package_dir "@MODERN_IO_PACKAGE_SMOKE_PACKAGE_DIR@")
set(_consumer_source_dir "@MODERN_IO_PACKAGE_SMOKE_SOURCE_DIR@")
set(_consumer_build_dir "@MODERN_IO_PACKAGE_SMOKE_BUILD_DIR@")
set(_package_build_targets "@MODERN_IO_PACKAGE_SMOKE_BUILD_TARGETS@")
set(_consumer_configure_args "@MODERN_IO_PACKAGE_SMOKE_CONFIGURE_ARGS@")
set(_expected_package_files "@MODERN_IO_PACKAGE_SMOKE_EXPECTED_FILES@")

file(REMOVE_RECURSE "${_install_prefix}" "${_consumer_build_dir}")

set(_package_build_cmd
  "@CMAKE_COMMAND@"
  --build "@CMAKE_BINARY_DIR@"
  --target
)
foreach(_package_target IN LISTS _package_build_targets)
  list(APPEND _package_build_cmd "${_package_target}")
endforeach()
if(NOT _test_config STREQUAL "")
  list(APPEND _package_build_cmd --config "${_test_config}")
endif()

execute_process(
  COMMAND ${_package_build_cmd}
  RESULT_VARIABLE _package_build_result
  OUTPUT_VARIABLE _package_build_stdout
  ERROR_VARIABLE _package_build_stderr
)
if(NOT _package_build_result EQUAL 0)
  message(FATAL_ERROR
    "modern_io package pre-build failed.\n"
    "stdout:\n${_package_build_stdout}\n"
    "stderr:\n${_package_build_stderr}"
  )
endif()

set(_install_cmd
  "@CMAKE_COMMAND@"
  --install "@CMAKE_BINARY_DIR@"
  --prefix "${_install_prefix}"
)
if(NOT _test_config STREQUAL "")
  list(APPEND _install_cmd --config "${_test_config}")
endif()

execute_process(
  COMMAND ${_install_cmd}
  RESULT_VARIABLE _install_result
  OUTPUT_VARIABLE _install_stdout
  ERROR_VARIABLE _install_stderr
)
if(NOT _install_result EQUAL 0)
  message(FATAL_ERROR
    "modern_io package install failed.\n"
    "stdout:\n${_install_stdout}\n"
    "stderr:\n${_install_stderr}"
  )
endif()

if(NOT EXISTS "${_package_dir}/modern_ioConfig.cmake")
  message(FATAL_ERROR "Installed package config is missing: ${_package_dir}/modern_ioConfig.cmake")
endif()
if(NOT EXISTS "${_package_dir}/modern_ioConfigVersion.cmake")
  message(FATAL_ERROR "Installed package version file is missing: ${_package_dir}/modern_ioConfigVersion.cmake")
endif()

foreach(_expected_file IN LISTS _expected_package_files)
  if(NOT EXISTS "${_package_dir}/${_expected_file}")
    message(FATAL_ERROR "Installed package file is missing: ${_package_dir}/${_expected_file}")
  endif()
endforeach()

file(READ "${_package_dir}/modern_ioCoreTargets.cmake" _targets_file_contents)
if(NOT _targets_file_contents MATCHES "FILE_SET \"cxx_modules\"")
  message(FATAL_ERROR "Installed package does not export the expected cxx_modules file sets.")
endif()

set(_configure_cmd
  "@CMAKE_COMMAND@"
  -S "${_consumer_source_dir}"
  -B "${_consumer_build_dir}"
  -G "@CMAKE_GENERATOR@"
  "-DCMAKE_PREFIX_PATH=${_install_prefix}"
  "-Dmodern_io_DIR=${_package_dir}"
  "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
)

if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
  list(APPEND _configure_cmd -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
  list(APPEND _configure_cmd -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
if(NOT "@CMAKE_MAKE_PROGRAM@" STREQUAL "")
  list(APPEND _configure_cmd "-DCMAKE_MAKE_PROGRAM=@CMAKE_MAKE_PROGRAM@")
endif()
if("@CMAKE_CONFIGURATION_TYPES@" STREQUAL "")
  list(APPEND _configure_cmd "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@")
endif()
foreach(_configure_arg IN LISTS _consumer_configure_args)
  list(APPEND _configure_cmd "${_configure_arg}")
endforeach()

execute_process(
  COMMAND ${_configure_cmd}
  RESULT_VARIABLE _configure_result
  OUTPUT_VARIABLE _configure_stdout
  ERROR_VARIABLE _configure_stderr
)
if(NOT _configure_result EQUAL 0)
  message(FATAL_ERROR
    "modern_io package consumer configure failed.\n"
    "stdout:\n${_configure_stdout}\n"
    "stderr:\n${_configure_stderr}"
  )
endif()

set(_build_cmd
  "@CMAKE_COMMAND@"
  --build "${_consumer_build_dir}"
)
if(NOT _test_config STREQUAL "")
  list(APPEND _build_cmd --config "${_test_config}")
endif()

execute_process(
  COMMAND ${_build_cmd}
  RESULT_VARIABLE _build_result
  OUTPUT_VARIABLE _build_stdout
  ERROR_VARIABLE _build_stderr
)
if(NOT _build_result EQUAL 0)
  message(FATAL_ERROR
    "modern_io package consumer build failed.\n"
    "stdout:\n${_build_stdout}\n"
    "stderr:\n${_build_stderr}"
  )
endif()
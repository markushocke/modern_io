# Generated by modern_io for installed core targets.

if(TARGET modern_io::modern_io AND TARGET modern_io::net_io AND TARGET modern_io::net_io_adapters AND TARGET modern_io::modern_all_core)
  return()
endif()

get_filename_component(_IMPORT_PREFIX "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)
if(_IMPORT_PREFIX STREQUAL "/")
  set(_IMPORT_PREFIX "")
endif()

if(TARGET modern_trace::modern_trace)
  set(_modern_trace_target modern_trace::modern_trace)
elseif(TARGET modern_trace)
  set(_modern_trace_target modern_trace)
else()
  message(FATAL_ERROR "modern_io core targets require target modern_trace::modern_trace or modern_trace")
endif()

get_target_property(_modern_trace_source_root "${_modern_trace_target}" MODERN_TRACE_SOURCE_ROOT)
if(NOT _modern_trace_source_root)
  set(_modern_trace_source_root "${_IMPORT_PREFIX}/@CMAKE_INSTALL_INCLUDEDIR@/modern_trace")
endif()

function(_modern_io_set_imported_modules target)
  set_property(TARGET "${target}" PROPERTY IMPORTED_CXX_MODULES_RELWITHDEBINFO ${ARGN})
  set_property(TARGET "${target}" PROPERTY IMPORTED_CXX_MODULES_DEBUG ${ARGN})
  set_property(TARGET "${target}" PROPERTY IMPORTED_CXX_MODULES_RELEASE ${ARGN})
  set_property(TARGET "${target}" PROPERTY IMPORTED_CXX_MODULES_MINSIZEREL ${ARGN})
  set_property(TARGET "${target}" PROPERTY IMPORTED_CXX_MODULES_NOCONFIG ${ARGN})
endfunction()

